# Copia este archivo a .env.local y llena los valores.
# .env.local NO se sube a git.

# Supabase → Settings → API. La "publishable" es la que antes se llamaba
# anon; la "secret" es la que antes se llamaba service_role.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Genéralas con: npx web-push generate-vapid-keys
# La pública va dos veces: el navegador necesita la que lleva NEXT_PUBLIC_.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Debe ser un mailto: real. Va en cada push; Apple y Google lo usan para
# contactarte si algo sale mal.
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Cloudflare Turnstile. OJO con el orden: el SITE key es el corto (~24
# caracteres) y el SECRET el largo (~35). Invertirlos da error 400020 y
# nadie puede publicar.
# El widget debe tener registrado el dominio: localhost para desarrollo,
# y el dominio real para producción.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Para desarrollo local puedes usar las llaves de prueba de Cloudflare,
# que siempre pasan. NUNCA en producción: dejan pasar a cualquiera.
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
