# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# El ejemplo sí se versiona: no tiene valores reales.
!.env.local.example

# Migración entre proyectos de Supabase.
# 05-datos-cuentas.sql lleva correos, teléfonos, nombres y un número de
# matrícula profesional de personas reales. NUNCA se versiona.
# El runbook y el seed de servicios sí pueden ir: no tienen datos personales.
/migracion/05-datos-cuentas.sql
/migracion/*-datos-*.sql

# Drizzle: solo se versionan los tipos generados (src/db/generado/*.ts).
# El SQL de base y los snapshots no — el esquema lo manda supabase/migraciones/,
# y un 0000_*.sql que recrea 37 tablas es una escopeta cargada apuntando a la
# base de producción.
/src/db/generado/*.sql
/src/db/generado/meta/

# Ayudante local para aplicar migraciones contra la base de pruebas.
.aplicar.mjs

# Original del diseñador (docs/marca/Logo). Los PNG de 4267 px y el .ai pesan
# 59 MB y se regeneran desde el SVG, que es la fuente y sí se versiona —igual
# que los PNG mini, que son de 67 a 134 px—. Los iconos de la aplicación salen
# de ahí con `node scripts/iconos.mjs`.
/docs/marca/Logo/*.png
/docs/marca/Logo/*.ai
/docs/marca/Logo/PNG/*1024X1024*.png
/docs/marca/Logo/PNG/*ENMASCARABLE*.png

# Estado local de la CLI de Supabase: a qué proyecto está enlazada ESTA
# máquina. Es de quien programa, no del repositorio.
/supabase/.temp/
